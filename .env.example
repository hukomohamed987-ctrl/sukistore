# Suki Store - Environment Variables Template
PORT=3000
NODE_ENV=production

# JWT Security (Generate a long random 64-char string for production)
JWT_SECRET=replace_with_a_very_long_secure_random_string_in_production
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# CORS & Security (other sites allowed to call the API; your own site always works)
ALLOWED_ORIGINS=https://souqystore.com,https://www.souqystore.com
FORCE_HTTPS=true

# Which proxies may set the visitor IP (X-Forwarded-For).
# Default (empty) = proxy on the same machine / private network (cPanel, Apache, Nginx).
# Behind Cloudflare in front of that proxy use the number of hops, e.g. TRUST_PROXY=2
TRUST_PROXY=

# Email codes (Resend). RESEND_FROM must be an address on a domain verified in Resend,
# otherwise Resend only delivers to the Resend account owner.
RESEND_API_KEY=
RESEND_FROM=سوقي ستور <no-reply@souqystore.com>

# LOCAL TESTING ONLY: return email codes in the API response (ignored when NODE_ENV=production)
OTP_DEBUG_ECHO=false

# Brute Force & Rate Limiting
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=250

# Super Admin IP Restriction (e.g. 197.34.12.55,10.0.0.1)
SUPER_ADMIN_ALLOWED_IPS=

# Google OAuth 2.0 Credentials (Get from Google Cloud Console -> APIs & Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://your-production-domain.com/api/auth/google/callback

